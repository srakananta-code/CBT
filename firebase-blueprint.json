{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profil pengguna sistem E-UJIAN SEKOLAH (Admin, Guru, atau Siswa)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "teacher", "student"] },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended"] },
        "classId": { "type": "string", "maxLength": 64 },
        "className": { "type": "string", "maxLength": 50 },
        "nisn": { "type": "string", "maxLength": 20 },
        "nip": { "type": "string", "maxLength": 30 },
        "assignedSubjects": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "Class": {
      "title": "Class",
      "description": "Rombongan belajar tingkat SMP/MTs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "grade": { "type": "string", "enum": ["VII", "VIII", "IX"] },
        "name": { "type": "string", "maxLength": 50 },
        "academicYearId": { "type": "string", "maxLength": 64 },
        "homeroomTeacherId": { "type": "string", "maxLength": 128 },
        "homeroomTeacherName": { "type": "string", "maxLength": 100 },
        "studentCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["grade", "name", "academicYearId"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Mata pelajaran sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 20 },
        "gradeLevel": { "type": "string", "enum": ["VII", "VIII", "IX", "all"] },
        "teacherIds": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "code"]
    },
    "AcademicYear": {
      "title": "AcademicYear",
      "description": "Periode tahun ajaran dan status semester",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 30 },
        "semester": { "type": "string", "enum": ["ganjil", "genap"] },
        "isActive": { "type": "boolean" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" }
      },
      "required": ["name", "semester", "isActive"]
    },
    "Question": {
      "title": "Question",
      "description": "Item master bank soal ujian sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "gradeLevel": { "type": "string", "enum": ["VII", "VIII", "IX"] },
        "type": { "type": "string", "enum": ["multiple_choice", "essay", "true_false", "matching"] },
        "questionText": { "type": "string", "maxLength": 10000 },
        "questionImage": { "type": "string", "maxLength": 500 },
        "options": { "type": "array" },
        "topic": { "type": "string", "maxLength": 100 },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["subjectId", "type", "questionText", "difficulty", "creatorId"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Paket jadwal dan aturan ujian CBT",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "targetClassIds": { "type": "array" },
        "targetClassNames": { "type": "array" },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 100 },
        "durationMinutes": { "type": "number" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "token": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["draft", "published", "ongoing", "completed", "archived"] },
        "rules": { "type": "object" },
        "totalQuestions": { "type": "number" },
        "passingScore": { "type": "number" },
        "showResultImmediately": { "type": "boolean" },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "subjectId", "durationMinutes", "status", "teacherId"]
    },
    "ExamQuestionSnapshot": {
      "title": "ExamQuestionSnapshot",
      "description": "Snapshot butir soal yang di-freeze saat ujian diterbitkan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 64 },
        "questionId": { "type": "string", "maxLength": 64 },
        "orderNumber": { "type": "number" },
        "type": { "type": "string", "maxLength": 30 },
        "questionText": { "type": "string", "maxLength": 10000 },
        "questionImage": { "type": "string", "maxLength": 500 },
        "options": { "type": "array" },
        "weight": { "type": "number" },
        "topic": { "type": "string", "maxLength": 100 },
        "difficulty": { "type": "string", "maxLength": 20 },
        "snapshotAt": { "type": "string" }
      },
      "required": ["examId", "questionId", "orderNumber", "questionText"]
    },
    "ExamAnswerKey": {
      "title": "ExamAnswerKey",
      "description": "Kunci jawaban privat yang dipisahkan dan dilindungi dari siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 64 },
        "questionId": { "type": "string", "maxLength": 64 },
        "correctAnswer": { "type": "string", "maxLength": 500 },
        "scoreValue": { "type": "number" },
        "rubricExplanation": { "type": "string", "maxLength": 2000 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["examId", "questionId", "correctAnswer", "scoreValue"]
    },
    "ExamSession": {
      "title": "ExamSession",
      "description": "Sesi aktif pengerjaan ujian siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentClass": { "type": "string", "maxLength": 50 },
        "startTime": { "type": "string" },
        "endTimeDeadline": { "type": "string" },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["ongoing", "submitted", "timed_out", "blocked"] },
        "violationCount": { "type": "number" },
        "ipAddress": { "type": "string", "maxLength": 50 },
        "userAgent": { "type": "string", "maxLength": 250 }
      },
      "required": ["examId", "studentId", "status", "startTime", "endTimeDeadline"]
    },
    "SessionAnswer": {
      "title": "SessionAnswer",
      "description": "Jawaban siswa per butir soal di dalam sesi ujian",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "questionId": { "type": "string", "maxLength": 64 },
        "selectedOption": { "type": "string", "maxLength": 500 },
        "essayAnswer": { "type": "string", "maxLength": 5000 },
        "isDoubtful": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["sessionId", "examId", "studentId", "questionId"]
    },
    "Result": {
      "title": "Result",
      "description": "Hasil dan rekapitulasi penilaian ujian peserta",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "className": { "type": "string", "maxLength": 50 },
        "correctCount": { "type": "number" },
        "wrongCount": { "type": "number" },
        "unansweredCount": { "type": "number" },
        "finalScore": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "graded", "published"] },
        "publishedAt": { "type": "string" },
        "gradedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["examId", "studentId", "finalScore", "status"]
    },
    "ProctoringEvent": {
      "title": "ProctoringEvent",
      "description": "Log kejadian pengawasan anti-curang selama ujian",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "eventType": { "type": "string", "enum": ["tab_switch", "window_blur", "fullscreen_exit", "keyboard_shortcut"] },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" }
      },
      "required": ["sessionId", "examId", "studentId", "eventType", "timestamp"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Catatan rekam jejak audit sistem penting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 20 },
        "action": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Konfigurasi umum aplikasi sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "schoolNpsn": { "type": "string", "maxLength": 20 },
        "activeAcademicYear": { "type": "string", "maxLength": 50 },
        "activeSemester": { "type": "string", "enum": ["ganjil", "genap"] },
        "allowReviewAfterExam": { "type": "boolean" },
        "cbtStrictFocusMode": { "type": "boolean" },
        "maxViolationsAllowed": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["schoolName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Profil pengguna: Admin, Guru, dan Siswa"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Class" },
      "description": "Daftar rombel kelas SMP/MTs"
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Mata pelajaran kurikulum sekolah"
    },
    "/academicYears/{yearId}": {
      "schema": { "$ref": "#/entities/AcademicYear" },
      "description": "Tahun ajaran dan status semester"
    },
    "/questionBank/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Bank soal master yang dikelola Guru/Admin"
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Jadwal dan konfigurasi paket ujian CBT"
    },
    "/examQuestionSnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/ExamQuestionSnapshot" },
      "description": "Snapshot butir soal yang di-freeze per ujian (aman dibaca siswa)"
    },
    "/examAnswerKeys/{keyId}": {
      "schema": { "$ref": "#/entities/ExamAnswerKey" },
      "description": "Kunci jawaban ujian rahasia terisolasi total dari siswa"
    },
    "/examSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ExamSession" },
      "description": "Sesi pengerjaan ujian per peserta siswa"
    },
    "/examSessions/{sessionId}/answers/{answerId}": {
      "schema": { "$ref": "#/entities/SessionAnswer" },
      "description": "Subkoleksi jawaban siswa per butir soal dalam sesi"
    },
    "/results/{resultId}": {
      "schema": { "$ref": "#/entities/Result" },
      "description": "Hasil rekap nilai ujian"
    },
    "/proctoringEvents/{eventId}": {
      "schema": { "$ref": "#/entities/ProctoringEvent" },
      "description": "Catatan kejadian proctoring anti-curang"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Log aktivitas audit sistem"
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSetting" },
      "description": "Pengaturan sekolah dan aturan global CBT"
    }
  }
}
